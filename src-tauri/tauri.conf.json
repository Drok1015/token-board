{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "额度脉搏",
  "version": "0.1.0",
  "identifier": "com.drok.huide-pet",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "title": "额度脉搏", "width": 236, "height": 175, "transparent": true, "decorations": false, "alwaysOnTop": true, "shadow": false, "resizable": false, "skipTaskbar": true, "visibleOnAllWorkspaces": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "11.0" } }
}
