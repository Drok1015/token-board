{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token 看板",
  "version": "0.2.14",
  "identifier": "com.drok.token-board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Token 看板",
        "width": 300,
        "height": 175,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRDMwQjVBNzNDMTVFQkUKUldTK1hzRnpXZ3ZUUHcxWmJpaXJHNEV1dk1zemFqYU5FWk14bXB1M3VZNDJDajVJUklqSkpiaHUK",
      "endpoints": [
        "https://github.com/Drok1015/token-board/releases/latest/download/latest.json"
      ]
    }
  }
}
